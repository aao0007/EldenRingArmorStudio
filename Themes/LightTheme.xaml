<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Fondos ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackground"         Color="#F0EDE8"/>
    <SolidColorBrush x:Key="PanelBackground"       Color="#F8F5F0"/>
    <SolidColorBrush x:Key="SurfaceBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt"            Color="#F0EDE8"/>
    <SolidColorBrush x:Key="CardBackground"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHover"             Color="#EEE8DF"/>
    <SolidColorBrush x:Key="CardSelected"          Color="#D8E8F8"/>

    <!-- ── Bordes ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderSubtle"          Color="#E0DAD2"/>
    <SolidColorBrush x:Key="BorderNormal"          Color="#CCC5BB"/>
    <SolidColorBrush x:Key="BorderStrong"          Color="#B0A898"/>
    <SolidColorBrush x:Key="BorderSelected"        Color="#5A90D8"/>

    <!-- ── Textos ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary"           Color="#1A1612"/>
    <SolidColorBrush x:Key="TextSecondary"         Color="#6A6258"/>
    <SolidColorBrush x:Key="TextDisabled"          Color="#B0A898"/>
    <SolidColorBrush x:Key="TextPlaceholder"       Color="#A09888"/>
    <SolidColorBrush x:Key="TextAccent"            Color="#8A6020"/>
    <SolidColorBrush x:Key="TextAccentBright"      Color="#A07428"/>

    <!-- ── Inputs ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InputBackground"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder"           Color="#CCC5BB"/>
    <SolidColorBrush x:Key="InputBorderFocus"      Color="#A07428"/>
    <SolidColorBrush x:Key="InputForeground"       Color="#1A1612"/>

    <!-- ── Menú ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="MenuBackground"        Color="#EDE8E0"/>
    <SolidColorBrush x:Key="MenuForeground"        Color="#2A2218"/>
    <SolidColorBrush x:Key="MenuItemHover"         Color="#DDD5C8"/>
    <SolidColorBrush x:Key="MenuItemHoverFg"       Color="#1A1612"/>
    <SolidColorBrush x:Key="MenuSeparator"         Color="#CCC5BB"/>

    <!-- ── Botones ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BtnPrimaryBg"          Color="#1A6BBF"/>
    <SolidColorBrush x:Key="BtnPrimaryBorder"      Color="#1255A0"/>
    <SolidColorBrush x:Key="BtnPrimaryFg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BtnSuccessBg"          Color="#287A28"/>
    <SolidColorBrush x:Key="BtnSuccessBorder"      Color="#1A5A1A"/>
    <SolidColorBrush x:Key="BtnSuccessFg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BtnNeutralBg"          Color="#E8E0D5"/>
    <SolidColorBrush x:Key="BtnNeutralBorder"      Color="#CCC5BB"/>
    <SolidColorBrush x:Key="BtnNeutralFg"          Color="#2A2218"/>

    <!-- ── Acento dorado ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentGold"            Color="#8A6020"/>
    <SolidColorBrush x:Key="AccentGoldDim"         Color="#C8A870"/>

    <!-- ── ScrollBar ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollBarTrack"        Color="#E8E0D5"/>
    <SolidColorBrush x:Key="ScrollBarThumb"        Color="#B0A898"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover"   Color="#8A8070"/>

    <!-- ── GroupBox ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="GroupBoxBorder"        Color="#CCC5BB"/>
    <SolidColorBrush x:Key="GroupBoxHeader"        Color="#8A6020"/>

    <!-- ── Tab ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TabBackground"         Color="#E8E0D5"/>
    <SolidColorBrush x:Key="TabForeground"         Color="#6A6258"/>
    <SolidColorBrush x:Key="TabSelectedBg"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabSelectedFg"         Color="#1A1612"/>

    <!-- ── Stats / overlay ───────────────────────────────────── -->
    <SolidColorBrush x:Key="StatsText"             Color="#8A6020"/>
    <SolidColorBrush x:Key="ViewportBackground"    Color="#1A1612"/>

    <!-- ── TreeView ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TreeBackground"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TreeItemHover"         Color="#EEE8DF"/>
    <SolidColorBrush x:Key="TreeItemSelected"      Color="#C8DDF5"/>

    <!-- ── Contadores / badge ─────────────────────────────────── -->
    <SolidColorBrush x:Key="CounterForeground"     Color="#8A8070"/>

</ResourceDictionary>
