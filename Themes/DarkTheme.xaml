<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Fondos ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackground"         Color="#0F0F13"/>
    <SolidColorBrush x:Key="PanelBackground"       Color="#17171E"/>
    <SolidColorBrush x:Key="SurfaceBackground"     Color="#1E1E28"/>
    <SolidColorBrush x:Key="SurfaceAlt"            Color="#25252F"/>
    <SolidColorBrush x:Key="CardBackground"        Color="#1E1E28"/>
    <SolidColorBrush x:Key="CardHover"             Color="#2A2A38"/>
    <SolidColorBrush x:Key="CardSelected"          Color="#2D3A52"/>

    <!-- ── Bordes ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderSubtle"          Color="#2A2A38"/>
    <SolidColorBrush x:Key="BorderNormal"          Color="#383848"/>
    <SolidColorBrush x:Key="BorderStrong"          Color="#4A4A60"/>
    <SolidColorBrush x:Key="BorderSelected"        Color="#4A7FCC"/>

    <!-- ── Textos ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary"           Color="#E8E8F0"/>
    <SolidColorBrush x:Key="TextSecondary"         Color="#9090A8"/>
    <SolidColorBrush x:Key="TextDisabled"          Color="#505065"/>
    <SolidColorBrush x:Key="TextPlaceholder"       Color="#50506A"/>
    <SolidColorBrush x:Key="TextAccent"            Color="#C9A96E"/>
    <SolidColorBrush x:Key="TextAccentBright"      Color="#E0BE88"/>

    <!-- ── Inputs ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InputBackground"       Color="#12121A"/>
    <SolidColorBrush x:Key="InputBorder"           Color="#383848"/>
    <SolidColorBrush x:Key="InputBorderFocus"      Color="#C9A96E"/>
    <SolidColorBrush x:Key="InputForeground"       Color="#E8E8F0"/>

    <!-- ── Menú ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="MenuBackground"        Color="#12121A"/>
    <SolidColorBrush x:Key="MenuForeground"        Color="#C8C8D8"/>
    <SolidColorBrush x:Key="MenuItemHover"         Color="#25252F"/>
    <SolidColorBrush x:Key="MenuItemHoverFg"       Color="#E8E8F0"/>
    <SolidColorBrush x:Key="MenuSeparator"         Color="#2A2A38"/>

    <!-- ── Botones ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BtnPrimaryBg"          Color="#1A5FB4"/>
    <SolidColorBrush x:Key="BtnPrimaryBorder"      Color="#1248A0"/>
    <SolidColorBrush x:Key="BtnPrimaryFg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BtnSuccessBg"          Color="#1A6B1A"/>
    <SolidColorBrush x:Key="BtnSuccessBorder"      Color="#0F500F"/>
    <SolidColorBrush x:Key="BtnSuccessFg"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BtnNeutralBg"          Color="#25252F"/>
    <SolidColorBrush x:Key="BtnNeutralBorder"      Color="#383848"/>
    <SolidColorBrush x:Key="BtnNeutralFg"          Color="#C8C8D8"/>

    <!-- ── Acento dorado ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentGold"            Color="#C9A96E"/>
    <SolidColorBrush x:Key="AccentGoldDim"         Color="#7A6440"/>

    <!-- ── ScrollBar ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollBarTrack"        Color="#12121A"/>
    <SolidColorBrush x:Key="ScrollBarThumb"        Color="#383848"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover"   Color="#4A4A60"/>

    <!-- ── GroupBox ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="GroupBoxBorder"        Color="#2A2A38"/>
    <SolidColorBrush x:Key="GroupBoxHeader"        Color="#C9A96E"/>

    <!-- ── Tab ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TabBackground"         Color="#17171E"/>
    <SolidColorBrush x:Key="TabForeground"         Color="#9090A8"/>
    <SolidColorBrush x:Key="TabSelectedBg"         Color="#1E1E28"/>
    <SolidColorBrush x:Key="TabSelectedFg"         Color="#E8E8F0"/>

    <!-- ── Stats / overlay ───────────────────────────────────── -->
    <SolidColorBrush x:Key="StatsText"             Color="#C9A96E"/>
    <SolidColorBrush x:Key="ViewportBackground"    Color="#0B0B0F"/>

    <!-- ── TreeView ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TreeBackground"        Color="#12121A"/>
    <SolidColorBrush x:Key="TreeItemHover"         Color="#1E1E28"/>
    <SolidColorBrush x:Key="TreeItemSelected"      Color="#1A3A6A"/>

    <!-- ── Contadores / badge ─────────────────────────────────── -->
    <SolidColorBrush x:Key="CounterForeground"     Color="#6A6A80"/>

</ResourceDictionary>
