<UserControl x:Class="EldenRingArmorStudio.UI.Viewer3D.Viewport3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=OpenTK.GLWpfControl"
             Background="#0E0E10"
             Focusable="True"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseWheel="OnMouseWheel">
    <Grid>
        <glWpf:GLWpfControl x:Name="GlControl" Render="GlControl_Render"/>

        <TextBlock x:Name="TxtStats" Foreground="#C9A96E" FontWeight="Bold" Margin="10" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    </Grid>
</UserControl>