<Window x:Class="EldenRingArmorStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:viewer="clr-namespace:EldenRingArmorStudio.UI.Viewer3D"
        xmlns:panels="clr-namespace:EldenRingArmorStudio.UI.Panels"
        Title="Elden Ring Armor Studio - C# Edition" Height="720" Width="1280"
        Background="#F5F5F5"
        AllowDrop="True" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F0F0F0" Foreground="Black" Padding="2">
            <MenuItem Header="Archivo">
                <MenuItem Header="Configurar Directorio de Modelos..." Click="MenuConfigurarModelos_Click"/>
                <MenuItem Header="Recargar CSV (desde /data)" Click="MenuRecargarCsv_Click"/>
                <MenuItem Header="Guardar Cambios (.csv)"/>
                <Separator/>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Herramientas">
                <MenuItem Header="Ejecutar WitchyBND Unpack"/>
                <MenuItem Header="Generar Invisible Flags" Click="MenuGenerarFlags_Click"/>
            </MenuItem>
        </Menu>

        <dock:DockingManager Grid.Row="1">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Vertical">

                    <dock:LayoutPanel Orientation="Horizontal">

                        <dock:LayoutAnchorablePane DockWidth="350">
                            <dock:LayoutAnchorable Title="Propiedades de Armadura" CanClose="False">
                                <panels:ArmorInfoPanel x:Name="InfoPanel"/>
                            </dock:LayoutAnchorable>

                            <dock:LayoutAnchorable Title="Archivos (Mods/Parts)" CanClose="False">
                                <panels:FileTreePanel x:Name="FileTree"/>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>

                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument Title="Visualizador FLVER 3D" CanClose="False">
                                <viewer:Viewport3DControl x:Name="FlverViewport"/>
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>

                    </dock:LayoutPanel>

                    <dock:LayoutAnchorablePane DockHeight="250">
                        <dock:LayoutAnchorable Title="Explorador de Armaduras" CanClose="False">
                            <panels:ArmorExplorerPanel x:Name="ExplorerPanel"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>
    </Grid>
</Window>