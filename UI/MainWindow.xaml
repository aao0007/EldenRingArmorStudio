<Window x:Class="EldenRingArmorStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:viewer="clr-namespace:EldenRingArmorStudio.UI.Viewer3D"
        Title="Elden Ring Armor Studio - C# Edition" Height="720" Width="1280"
        Background="#1E1E1E"
        AllowDrop="True" 
        Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#2D2D30" Foreground="White">
            <MenuItem Header="Archivo">
                <MenuItem Header="Abrir Game Directory..."/>
                <MenuItem Header="Guardar Cambios (.csv)"/>
                <Separator/>
                <MenuItem Header="Salir"/>
            </MenuItem>
            <MenuItem Header="Herramientas">
                <MenuItem Header="Ejecutar WitchyBND Unpack"/>
                <MenuItem Header="Generar Invisible Flags"/>
            </MenuItem>
        </Menu>

        <dock:DockingManager Grid.Row="1" Theme="{Binding Source={StaticResource VS2013DarkTheme}}">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">

                    <dock:LayoutAnchorablePane DockWidth="300">
                        <dock:LayoutAnchorable Title="Lista de Armaduras (SQLite)" CanClose="False">
                            <ListBox x:Name="ArmorListBox" Background="#252526" Foreground="White"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <dock:LayoutDocumentPane>
                        <dock:LayoutDocument Title="Visualizador FLVER 3D" CanClose="False">
                            <viewer:Viewport3DControl x:Name="FlverViewport"/>
                        </dock:LayoutDocument>
                    </dock:LayoutDocumentPane>

                    <dock:LayoutAnchorablePane DockWidth="350">
                        <dock:LayoutAnchorable Title="Propiedades y Params / Smithbox" CanClose="False">
                            <Grid Background="#252526">
                                <TextBlock Text="Selecciona una pieza para ver sus flags ocultos." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>
    </Grid>
</Window>