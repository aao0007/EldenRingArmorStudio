<Window x:Class="EldenRingArmorStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:viewer="clr-namespace:EldenRingArmorStudio.UI.Viewer3D"
        xmlns:panels="clr-namespace:EldenRingArmorStudio.UI.Panels"
        Title="Elden Ring Armor Studio"
        Height="780" Width="1380"
        Background="{DynamicResource AppBackground}"
        AllowDrop="True" Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- ── Menú ── -->
        <Menu Grid.Row="0"
              Background="{DynamicResource MenuBackground}"
              Foreground="{DynamicResource MenuForeground}"
              Padding="4,2">

            <MenuItem Header="Archivo">
                <MenuItem Header="Recargar CSV"  Click="MenuRecargarCsv_Click"/>
                <MenuItem Header="Vaciar BD"     Click="MenuVaciarBd_Click"/>
                <Separator/>
                <MenuItem Header="Salir"         Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Herramientas">
                <MenuItem Header="Generar Invisible Flags" Click="MenuGenerarFlags_Click"/>
            </MenuItem>

            <MenuItem Header="Vista">
                <MenuItem x:Name="MenuToggleTheme"
                          Header="☀  Cambiar a Tema Claro"
                          Click="MenuToggleTheme_Click"/>
            </MenuItem>

            <!-- Configuración -->
            <MenuItem Header="⚙ Configuración" Click="MenuSettings_Click"/>

        </Menu>

        <!-- ── Layout ── -->
        <dock:DockingManager x:Name="DockManager"
                             Grid.Row="1"
                             Background="{DynamicResource AppBackground}">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Vertical">

                    <dock:LayoutPanel Orientation="Horizontal" DockHeight="530">

                        <!-- Izquierda: árbol -->
                        <dock:LayoutAnchorablePane DockWidth="230">
                            <dock:LayoutAnchorable Title="Archivos" CanClose="False">
                                <panels:FileTreePanel x:Name="FileTree"/>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>

                        <!-- Centro: visor 3D -->
                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument Title="Visualizador FLVER 3D" CanClose="False">
                                <viewer:Viewport3DControl x:Name="FlverViewport"/>
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>

                        <!-- Duplicador -->
                        <dock:LayoutAnchorablePane DockWidth="300">
                            <dock:LayoutAnchorable Title="Duplicar modelo a slots" CanClose="False">
                                <panels:DuplicatorPanel x:Name="DupPanel"/>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>

                        <!-- ArmorInfoPanel -->
                        <dock:LayoutAnchorablePane DockWidth="280">
                            <dock:LayoutAnchorable Title="Propiedades" CanClose="False">
                                <panels:ArmorInfoPanel x:Name="InfoPanel"/>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>

                    </dock:LayoutPanel>

                    <!-- Explorador DB -->
                    <dock:LayoutAnchorablePane DockHeight="230">
                        <dock:LayoutAnchorable Title="Explorador de Armaduras (DB)" CanClose="False">
                            <panels:ArmorExplorerPanel x:Name="ExplorerPanel"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <!-- Barra de estado -->
        <Border Grid.Row="2"
                Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatusBar"
                       Text="Listo"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="8,0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
