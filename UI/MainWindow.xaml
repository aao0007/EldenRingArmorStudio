<Window x:Class="EldenRingArmorStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewer="clr-namespace:EldenRingArmorStudio.UI.Viewer3D"
        mc:Ignorable="d"
        Title="Elden Ring Armor Studio - C# Edition" Height="720" Width="1280"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="5" Background="#2D2D30">
                    <TextBlock Text="Carpeta de Modelos (parts):" Foreground="White" FontSize="11" Margin="0,0,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPartsDirectory" Grid.Column="0" IsReadOnly="True" Background="#1E1E1E" Foreground="Gray" BorderBrush="#3F3F46" FontSize="11" VerticalAlignment="Center" Padding="2"/>
                        <Button x:Name="BtnBrowseDirectory" Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0" Background="#3E3E42" Foreground="White" Click="BtnBrowseDirectory_Click"/>
                    </Grid>
                </StackPanel>

                <GroupBox Grid.Row="1" Header="Archivos Físicos (.partsbnd.dcx)" Foreground="White" Margin="5" BorderBrush="#3F3F46">
                    <ListBox x:Name="ModelFilesListBox" Background="#1E1E1E" Foreground="White" BorderThickness="0" Margin="2" SelectionChanged="ModelFilesListBox_SelectionChanged"/>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Detalles del Objeto Seleccionado" Foreground="White" Margin="5" BorderBrush="#3F3F46">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="ImgSelectedIcon" Grid.Column="0" Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,8,0" Stretch="Uniform"/>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TxtSelectedModelName" Text="Ninguno" Foreground="#FFD700" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSelectedModelFile" Text="-" Foreground="#A9A9A9" FontSize="11" Margin="0,0,0,8"/>

                                <TextBlock Text="Métrica de Atributos:" Foreground="#9CDCFE" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="TxtSelectedModelStats" Text="-" Foreground="White" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8"/>

                                <TextBlock Text="Ruta Absoluta:" Foreground="#9CDCFE" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="TxtSelectedModelPath" Text="-" Foreground="Gray" TextWrapping="Wrap" FontSize="10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#3F3F46"/>

            <GroupBox Grid.Column="2" Header="Visor de Modelos 3D" Foreground="White" Margin="5" BorderBrush="#3F3F46">
                <viewer:Viewport3DControl x:Name="Viewport3DViewer"/>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#3F3F46"/>

        <GroupBox Grid.Row="2" Header="Base de Datos del CSV (EquipParamProtector)" Foreground="White" Margin="5" BorderBrush="#3F3F46" Background="#252526">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Filtrar Armadura:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtSearchDb" Width="220" Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" VerticalAlignment="Center" Padding="2" TextChanged="TxtSearchDb_TextChanged"/>
                </StackPanel>

                <DataGrid x:Name="ArmorGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#1E1E1E" Foreground="White" RowBackground="#2D2D30" AlternatingRowBackground="#252526"
                          BorderThickness="0" GridLinesVisibility="None" HorizontalGridLinesBrush="#3F3F46" Margin="2"
                          SelectionChanged="ArmorGrid_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model ID" Binding="{Binding EquipModelId}" Width="100"/>
                        <DataGridTextColumn Header="Nombre (ES)" Binding="{Binding NameEs}" Width="180"/>
                        <DataGridTextColumn Header="Nombre (EN)" Binding="{Binding NameEn}" Width="180"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="Set o Conjunto" Binding="{Binding SetName}" Width="150"/>
                        <DataGridTextColumn Header="Peso" Binding="{Binding Weight, StringFormat={}{0:F1}}" Width="60"/>
                        <DataGridTextColumn Header="Física" Binding="{Binding DefensePhys, StringFormat={}{0:P1}}" Width="70"/>
                        <DataGridTextColumn Header="Mágica" Binding="{Binding DefenseMagic, StringFormat={}{0:P1}}" Width="70"/>
                        <DataGridTextColumn Header="Estabilidad" Binding="{Binding Poise}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
