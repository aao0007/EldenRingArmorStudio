<UserControl x:Class="EldenRingArmorStudio.UI.Panels.DuplicatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,8">

            <TextBlock Text="Duplicar modelo a slots"
                       FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextAccent}"
                       Margin="0,0,0,10"/>

            <!-- ── Pack destino ── -->
            <TextBlock Text="Carpeta de destino (ModEngine/mod/...):"
                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,3"/>

            <!-- Lista de packs existentes -->
            <Border BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1" CornerRadius="4"
                    Height="90" Margin="0,0,0,6">
                <ListBox x:Name="LstPacks"
                         Background="{DynamicResource InputBackground}"
                         BorderThickness="0" FontSize="11"
                         SelectionChanged="OnPackListSelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Nueva carpeta -->
            <TextBlock Text="O escribe el nombre de una nueva carpeta:"
                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,3"/>
            <TextBox x:Name="TxtNewPack"
                     FontSize="11" Margin="0,0,0,4"
                     Tag="ej. MiMod_Negro"
                     TextChanged="OnNewPackTextChanged"/>

            <!-- Destino resuelto -->
            <TextBlock x:Name="TxtDestinoResuelto"
                       Text="→ (sin selección)"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextAccent}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,10"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- ── Opciones de duplicado ── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Género -->
                <Border BorderBrush="{DynamicResource BorderNormal}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="6,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Género:" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="RbMale"   Content="♂ M"
                                     IsChecked="True" FontSize="11"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="RbFemale" Content="♀ F"
                                     FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Alterado -->
                <Border BorderBrush="{DynamicResource BorderNormal}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="6,4">
                    <CheckBox x:Name="ChkAltered"
                              Content="+ alterado (_l)"
                              FontSize="11" VerticalAlignment="Center"
                              ToolTip="Duplica también la versión alterada con sufijo _l"/>
                </Border>
            </StackPanel>

            <!-- ── Categoría ── -->
            <TextBlock Text="Categoría:"
                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,3"/>
            <ComboBox x:Name="ComboCatFilter"
                      FontSize="11" Margin="0,0,0,8"
                      SelectionChanged="OnCatFilterChanged">
                <ComboBoxItem Content="🪖 Cabeza" Tag="Head"/>
                <ComboBoxItem Content="🥋 Cuerpo" Tag="Body"/>
                <ComboBoxItem Content="🧤 Brazos" Tag="Arms"/>
                <ComboBoxItem Content="👢 Piernas" Tag="Legs"/>
            </ComboBox>

            <!-- ── Buscador (no deselecciona) ── -->
            <TextBox x:Name="TxtIdSearch"
                     FontSize="11" Margin="0,0,0,6"
                     Tag="🔍 Filtrar lista (mantiene selección)…"
                     TextChanged="OnIdSearchChanged"/>

            <!-- ── Lista de IDs ordenada por ID ── -->
            <Border BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1" CornerRadius="4"
                    Height="200" Margin="0,0,0,6">
                <ListBox x:Name="LstIds"
                         Background="{DynamicResource InputBackground}"
                         BorderThickness="0"
                         SelectionMode="Multiple"
                         FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnIdsSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"    Value="6,3"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                TextBlock.Foreground="{DynamicResource TextPrimary}"
                                                TextBlock.FontSize="11"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource CardSelected}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource CardHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Selección rápida -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Seleccionar todo el set"
                        FontSize="10" Padding="6,4"
                        Click="OnSelectSet"/>
                <Button Content="Limpiar selección"
                        FontSize="10" Padding="6,4"
                        Margin="6,0,0,0"
                        Click="OnClearSelection"/>
            </StackPanel>

            <!-- Botón duplicar -->
            <Button x:Name="BtnDuplicate"
                    Content="▶  Duplicar a slots seleccionados"
                    FontSize="12" FontWeight="Bold"
                    Padding="8,8" IsEnabled="False"
                    Click="OnDuplicate"
                    Background="{DynamicResource BtnSuccessBg}"
                    BorderBrush="{DynamicResource BtnSuccessBorder}"
                    Foreground="{DynamicResource BtnSuccessFg}"
                    Margin="0,0,0,6"/>

            <!-- Botón vaciar -->
            <Button x:Name="BtnClear"
                    Content="🗑  Vaciar carpeta parts"
                    FontSize="11" Padding="8,6"
                    IsEnabled="False"
                    Click="OnClearFolder"
                    Background="#7A1A1A"
                    BorderBrush="#5A0A0A"
                    Foreground="White"
                    ToolTip="Elimina todos los .partsbnd.dcx de la carpeta parts seleccionada"
                    Margin="0,0,0,6"/>

            <!-- Estado -->
            <TextBlock x:Name="TxtStatus"
                       Text="" FontSize="10"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
