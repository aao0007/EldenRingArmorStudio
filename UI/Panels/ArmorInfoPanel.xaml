<UserControl x:Class="EldenRingArmorStudio.UI.Panels.ArmorInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EldenRingArmorStudio.Converters"
             Background="{DynamicResource PanelBackground}">

    <UserControl.Resources>
        <conv:IconIdToImageConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10" x:Name="PanelContent">

            <!-- Banner / icono -->
            <Border Height="116" CornerRadius="6"
                    Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1"
                    Margin="0,0,0,8">
                <Image x:Name="ImgBanner"
                       Stretch="Uniform" Margin="10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Nombre español -->
            <TextBlock x:Name="TxtNameEs"
                       Text="Selecciona una armadura"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource TextAccent}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,2"/>

            <!-- Nombre inglés -->
            <TextBlock x:Name="TxtNameEn"
                       Text="Haz clic en el explorador inferior"
                       FontSize="10" FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <Separator/>

            <!-- Identificadores -->
            <GroupBox Header="Identificadores" Margin="0,8,0,6">
                <Grid Margin="2,6,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Model ID:"  Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtId"    Foreground="{DynamicResource TextPrimary}"   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>

                    <TextBlock Text="Categoría:" Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCat"   Foreground="{DynamicResource TextPrimary}"   FontSize="10" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>

                    <TextBlock Text="Set:"       Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSet"   Foreground="{DynamicResource TextPrimary}"   FontSize="10" TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

                    <TextBlock Text="Alterado:"  Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAltered" Foreground="{DynamicResource TextPrimary}" FontSize="10" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>

                    <TextBlock Text="Género:"    Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtGender" Foreground="{DynamicResource TextPrimary}"  FontSize="10" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>

                    <TextBlock Text="Archivo:"   Foreground="{DynamicResource TextSecondary}" FontSize="10" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,1"/>
                    <TextBlock x:Name="TxtFile"  Foreground="{DynamicResource TextPrimary}"   FontSize="10" TextWrapping="Wrap" Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" Margin="0,1"/>
                </Grid>
            </GroupBox>

            <!-- Botón visor 3D -->
            <Button x:Name="BtnLoadModel"
                    Content="▶  Ver en visor 3D"
                    IsEnabled="False"
                    Click="OnLoadModelClick"
                    Margin="0,0,0,8"
                    Padding="8,6"
                    FontWeight="SemiBold"
                    Background="{DynamicResource BtnPrimaryBg}"
                    BorderBrush="{DynamicResource BtnPrimaryBorder}"
                    Foreground="{DynamicResource BtnPrimaryFg}"
                    BorderThickness="1"/>

            <!-- InvisibleFlags -->
            <GroupBox x:Name="GrpFlags"
                      Header="🔧 InvisibleFlags (Smithbox)"
                      Margin="0,0,0,8">
                <StackPanel x:Name="FlagsPanel" Margin="2,6,2,2"/>
            </GroupBox>

            <!-- Botón CSV -->
            <Button x:Name="BtnCsv"
                    Content="📄  Generar CSV de flags"
                    IsEnabled="False"
                    Click="OnGenerateCsvClick"
                    Padding="8,6"
                    FontWeight="SemiBold"
                    FontSize="11"
                    Background="{DynamicResource BtnSuccessBg}"
                    BorderBrush="{DynamicResource BtnSuccessBorder}"
                    Foreground="{DynamicResource BtnSuccessFg}"
                    BorderThickness="1"
                    ToolTip="Importar en Smithbox → Param Editor → EquipParamProtector → Import CSV"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
