<UserControl x:Class="EldenRingArmorStudio.UI.Panels.ArmorExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             Background="{DynamicResource PanelBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <Grid Grid.Row="0" Margin="8,5,8,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     FontSize="12"
                     TextChanged="OnSearchChanged"
                     Tag="🔍 Buscar armadura…"/>

            <ComboBox x:Name="ComboCat"
                      Grid.Column="1" Margin="6,0,0,0"
                      VerticalContentAlignment="Center"
                      FontSize="11"
                      SelectionChanged="OnCategoryChanged"/>

            <CheckBox x:Name="ChkAltered"
                      Grid.Column="2" Margin="8,0,0,0"
                      Content="Alterados"
                      FontSize="11"
                      VerticalAlignment="Center"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
        </Grid>

        <!-- Contador -->
        <TextBlock x:Name="TxtCount"
                   Grid.Row="1"
                   Text="0 resultados"
                   Foreground="{DynamicResource CounterForeground}"
                   FontSize="10"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>

        <!-- Grid virtualizado de armaduras -->
        <ListBox x:Name="ArmorGrid"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnDoubleClick">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding"          Value="2"/>
                    <Setter Property="Margin"           Value="3"/>
                    <Setter Property="Background"       Value="Transparent"/>
                    <Setter Property="BorderThickness"  Value="1"/>
                    <Setter Property="BorderBrush"      Value="Transparent"/>
                    <Setter Property="Cursor"           Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource CardSelected}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                Value="{DynamicResource BorderSelected}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource CardHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="112" Height="132">
                        <Border Width="68" Height="68"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1">
                            <Image Source="{Binding Thumbnail}"
                                   Width="60" Height="60"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxHeight="36"
                                   HorizontalAlignment="Center"
                                   Margin="2,3,2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
