<UserControl x:Class="EldenRingArmorStudio.UI.Panels.ArmorExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:localConverters="clr-namespace:EldenRingArmorStudio.Converters"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <UserControl.Resources>
        <localConverters:IconIdToImageConverter x:Key="IconConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,4,6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Padding="6,0"
                     Background="White" Foreground="Black"
                     BorderBrush="#CCCCCC" BorderThickness="1"
                     FontSize="12"
                     TextChanged="OnSearchChanged"
                     Tag="🔍 Buscar por ID, nombre o set..."/>

            <ComboBox x:Name="ComboCat"
                      Grid.Column="1" Margin="4,0,0,0"
                      VerticalContentAlignment="Center"
                      Background="White" Foreground="Black"
                      BorderBrush="#CCCCCC"
                      SelectionChanged="OnCategoryChanged"/>

            <CheckBox x:Name="ChkAltered"
                      Grid.Column="2" Margin="6,0,0,0"
                      Content="Alterados"
                      Foreground="Black" FontSize="11"
                      VerticalAlignment="Center"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
        </Grid>

        <TextBlock x:Name="TxtCount"
                   Grid.Row="1"
                   Text="0 resultados"
                   Foreground="#555555" FontSize="10"
                   Margin="8,0,0,0" VerticalAlignment="Center"/>

        <!--
            VirtualizingStackPanel en modo WrapGrid:
            ScrollUnit=Item es clave para que la virtualización funcione con wrap.
            VirtualizationMode=Recycling reutiliza contenedores en vez de crearlos de nuevo.
        -->
        <ListBox x:Name="ArmorGrid"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5" Padding="2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#99D1FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="112" Height="132">
                        <Image Source="{Binding Thumbnail}"
                               Width="64" Height="64"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality"/>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#333333" FontSize="10"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxHeight="34"
                                   HorizontalAlignment="Center"
                                   Margin="2,2,2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
