<Window x:Class="EldenRingArmorStudio.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Rutas de herramientas ── -->
                <TextBlock Text="Herramientas"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextAccent}"
                           Margin="0,0,0,10"/>

                <!-- WitchyBND -->
                <TextBlock Text="Ruta de WitchyBND (.exe):"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtWitchy" Grid.Column="0" FontSize="11"/>
                    <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                            Click="OnBrowseWitchy"/>
                </Grid>

                <!-- FLVER Editor -->
                <TextBlock Text="Ruta de FLVER Editor (.exe):"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFlver" Grid.Column="0" FontSize="11"/>
                    <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                            Click="OnBrowseFlver"/>
                </Grid>

                <!-- Smithbox -->
                <TextBlock Text="Ruta de Smithbox (.exe):"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSmithbox" Grid.Column="0" FontSize="11"/>
                    <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                            Click="OnBrowseSmithbox"/>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <!-- ── ModEngine2 ── -->
                <TextBlock Text="ModEngine2"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextAccent}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Carpeta raíz de ModEngine2:"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtModEngine" Grid.Column="0" FontSize="11"/>
                    <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                            Click="OnBrowseModEngine"/>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <!-- ── Proyecto ── -->
                <TextBlock Text="Proyecto"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextAccent}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Carpeta de biblioteca de parts (.partsbnd.dcx):"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPartsLib" Grid.Column="0" FontSize="11"/>
                    <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                            Click="OnBrowsePartsLib"/>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <!-- ── Apariencia ── -->
                <TextBlock Text="Apariencia"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextAccent}"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Tema:" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbDark"  Content="🌙 Oscuro"
                                 FontSize="11" Margin="0,0,16,0"
                                 VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbLight" Content="☀ Claro"
                                 FontSize="11"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Tamaño de grid (px):" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtGridSize" Width="60" FontSize="11"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones OK / Cancelar -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Guardar"
                    Width="90" Padding="0,6"
                    Background="{DynamicResource BtnPrimaryBg}"
                    BorderBrush="{DynamicResource BtnPrimaryBorder}"
                    Foreground="{DynamicResource BtnPrimaryFg}"
                    Click="OnSave"/>
            <Button Content="Cancelar"
                    Width="90" Padding="0,6"
                    Margin="8,0,0,0"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
