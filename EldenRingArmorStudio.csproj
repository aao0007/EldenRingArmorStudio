<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
		<PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
		<PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
		<PackageReference Include="Pfim" Version="0.11.4" />
		<PackageReference Include="BCnEncoder.Net" Version="2.3.0" />

		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.3" />
		<PackageReference Include="System.Text.Json" Version="10.0.8" />

		<!-- Panel wrap virtualizado: solo carga los items visibles en pantalla -->
		<PackageReference Include="VirtualizingWrapPanel" Version="2.1.2" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="SoulsFormats">
			<HintPath>Libs\SoulsFormats.dll</HintPath>
		</Reference>
		<None Update="data\EquipParamProtector.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Services\" />
		<Folder Include="tools\flver_editor\" />
		<Folder Include="tools\smithbox\" />
		<Folder Include="tools\witchybnd\" />
	</ItemGroup>

</Project>